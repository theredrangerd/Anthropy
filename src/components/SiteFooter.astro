---
import site from '../data/site.json';
const year = new Date().getUTCFullYear();
const socials = site.socials.filter((s) => !s.url.startsWith('REPLACE_WITH'));
const hasEmail = !site.contactEmail.startsWith('REPLACE_WITH');
---
<footer class="site-footer">
  <div class="page-shell inner">
    <p class="tagline">{site.tagline}</p>
    <div class="meta">
      <span>{site.name} · <a href={`${import.meta.env.BASE_URL}about/#timeline`}>Since {site.established}</a> · {site.basedAt}</span>
      {hasEmail && <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>}
      {socials.length > 0 && (
        <ul>
          {socials.map((s) => (
            <li><a href={s.url}>{s.label}</a></li>
          ))}
        </ul>
      )}
      <span class="copy">© {year} {site.name}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--s-24);
    padding-block: var(--s-12);
    background: var(--c-navy);
    color: var(--c-on-navy-soft);
    border-top: 3px solid var(--c-brass);
  }
  .inner { display: grid; gap: var(--s-6); }
  .tagline {
    font-family: var(--f-display);
    font-size: var(--t-lg);
    color: var(--c-on-navy);
    max-width: 46ch;
    line-height: 1.35;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-6);
    font-size: var(--t-sm);
  }
  .meta a { color: var(--c-on-navy); text-decoration-color: var(--c-brass); }
  .meta ul { display: flex; gap: var(--s-4); list-style: none; margin: 0; padding: 0; }
  .site-footer :focus-visible { outline-color: var(--c-brass); }
</style>
