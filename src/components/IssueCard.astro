---
interface Props {
  href: string;
  title: string;
  /** "Issue 3 · June 2026" */
  meta: string;
  year: number;
  summary: string;
  cover?: string;
  pdf?: string;
  paperTitles?: string[];
  featured?: boolean;
}

const { href, title, meta, year, summary, cover, pdf, paperTitles = [], featured = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const coverUrl = cover ? `${base}${cover.replace(/^\//, '')}` : undefined;
const shown = featured ? paperTitles.slice(0, 4) : [];
const hidden = paperTitles.length - shown.length;
const count = paperTitles.length;
const pdfUrl = pdf ? `${base}${pdf.replace(/^\//, '')}` : undefined;
---
<article class:list={['issue', { 'featured-item': featured }]}>
  <div class="cover" aria-hidden="true">
    {coverUrl ? (
      <img src={coverUrl} alt="" width="600" height="849" loading={featured ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <span class="fallback"><span class="yr">{year}</span></span>
    )}
  </div>
  <div class="body">
    <p class="meta">{meta}{count > 0 && <> · <span class="nw">{count} {count === 1 ? 'paper' : 'papers'}</span></>}</p>
    <h3><a href={href}>{title}</a></h3>
    <p class="summary">{summary}</p>
    {shown.length > 0 && (
      <ul class="contents" aria-label="Papers in this issue">
        {shown.map((t) => <li>{t}</li>)}
        {featured && hidden > 0 && <li class="more">and {hidden} more {hidden === 1 ? 'paper' : 'papers'}</li>}
      </ul>
    )}
    {featured && (
      <p class="actions">
        <a class="btn" href={href} aria-label={`Read the issue: ${title}`}>Read the issue</a>
        {pdfUrl && <a class="btn ghost" href={pdfUrl} download aria-label={`Download PDF: ${title}`}>PDF</a>}
      </p>
    )}
  </div>
</article>

<style>
  .issue {
    position: relative;
    display: grid;
    grid-template-columns: var(--cover-w, 7.5rem) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
  }
  .featured-item { --cover-w: min(16rem, 38%); gap: var(--s-8); }

  .cover {
    aspect-ratio: 990 / 1400;
    background: var(--c-navy);
    box-shadow: 0 1px 2px rgb(21 34 47 / 0.14), 0 8px 22px rgb(21 34 47 / 0.14);
    overflow: hidden;
  }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .fallback {
    display: grid;
    place-items: center;
    height: 100%;
    border: 6px double var(--c-brass);
    color: var(--c-on-navy);
  }
  .yr { font-family: var(--f-display); font-weight: 700; font-size: var(--t-xl); }

  .body { display: grid; gap: var(--s-3); padding-top: var(--s-1); }
  .meta {
    font-size: var(--t-sm);
    color: var(--c-ink-faint);
    font-variant-numeric: tabular-nums;
  }
  h3 { font-size: var(--t-lg); line-height: 1.2; text-wrap: balance; }
  .featured-item h3 { font-size: var(--t-2xl); }
  /* One stretched link: the whole card is the target and there is one tab stop. */
  h3 a { text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  h3 a:hover { text-decoration: underline; text-decoration-color: var(--c-brass); text-underline-offset: 0.2em; }
  .issue:hover .cover { box-shadow: 0 2px 4px rgb(21 34 47 / 0.16), 0 12px 28px rgb(21 34 47 / 0.18); }

  .summary {
    font-family: var(--f-prose);
    font-size: var(--t-base);
    color: var(--c-ink-soft);
    max-width: 60ch;
  }
  .summary { text-wrap: pretty; }
  .issue:not(.featured-item) .summary { font-size: var(--t-sm); }
  .nw { white-space: nowrap; }

  /* Above the stretched link so the actions stay separately clickable. */
  .actions { position: relative; z-index: 1; display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-4); }
  .btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--s-6);
    font-family: var(--f-ui);
    font-size: var(--t-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--c-on-navy);
    background: var(--c-navy);
    border: 1px solid var(--c-navy);
    transition: background-color 150ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .btn:hover { background: var(--c-navy-mid); }
  .btn.ghost { color: var(--c-navy); background: transparent; }
  .btn.ghost:hover { background: var(--c-sunk); }

  .contents {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    border-top: 1px solid var(--c-rule);
    max-width: 60ch;
  }
  .contents li {
    font-family: var(--f-prose);
    font-size: var(--t-sm);
    line-height: 1.4;
    padding-block: var(--s-2);
    border-bottom: 1px solid var(--c-rule);
  }
  .contents .more { color: var(--c-ink-faint); font-family: var(--f-ui); font-size: var(--t-xs); }

  @media (max-width: 640px) {
    .featured-item { grid-template-columns: minmax(0, 1fr); }
    .featured-item .cover { width: min(14rem, 70%); }
    .featured-item h3 { font-size: var(--t-xl); }
  }
</style>
