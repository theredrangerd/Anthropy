---
import timeline from '../data/timeline.json';

interface Event {
  year: number;
  dateLabel: string;
  title: string;
  description: string;
  /** Optional link target — when present, the title becomes a link. */
  href?: string;
}

interface Props {
  /** 'compact' is a horizontal strip of highlight beats (Home). 'full' is
   *  the complete vertical timeline (About). */
  variant?: 'compact' | 'full';
  /** compact only: how many of the most significant events to show. */
  limit?: number;
  /** compact only: link target for "the full story". */
  moreHref?: string;
}

const { variant = 'full', limit = 4, moreHref = `${import.meta.env.BASE_URL}about/#timeline` } = Astro.props;

const events = (timeline.events as Event[]).slice().sort((a, b) => a.year - b.year);
const shown = variant === 'compact' ? events.slice(-limit) : events;
---
{variant === 'compact' ? (
  <div class="timeline-compact">
    <ol>
      {shown.map((e) => (
        <li>
          <span class="date">{e.dateLabel}</span>
          <span class="title">{e.title}</span>
        </li>
      ))}
    </ol>
    {moreHref && <a class="more" href={moreHref}>The full story →</a>}
  </div>
) : (
  <ol class="timeline-full">
    {shown.map((e) => (
      <li>
        <span class="date">{e.dateLabel}</span>
        <div class="body">
          <p class="title">{e.href ? <a href={`${import.meta.env.BASE_URL}${e.href.replace(/^\//, '')}`}>{e.title}</a> : e.title}</p>
          <p class="description">{e.description}</p>
        </div>
      </li>
    ))}
  </ol>
)}

<style>
  /* Compact: a horizontal strip of dated beats, read left to right in
     chronological order, ending in a link to the full timeline. */
  .timeline-compact {
    display: grid;
    gap: var(--s-4);
  }
  .timeline-compact ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: var(--s-6);
  }
  .timeline-compact li {
    display: grid;
    gap: var(--s-1);
    padding-top: var(--s-3);
    border-top: 2px solid var(--c-sage);
  }
  .timeline-compact .date {
    font-family: var(--f-ui);
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-ink-faint);
  }
  .timeline-compact .title {
    font-family: var(--f-display);
    font-size: var(--t-base);
    color: var(--c-ink);
  }
  .timeline-compact .more {
    justify-self: start;
    font-family: var(--f-ui);
    font-size: var(--t-sm);
    text-decoration: none;
  }
  .timeline-compact .more:hover { text-decoration: underline; text-decoration-color: var(--c-sage); }

  /* Full: a brass spine with each event's date set large in the display
     face to the left and its story to the right. The newest entry is
     marked with a filled navy node. */
  .timeline-full {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-left: 1px solid var(--c-brass);
    margin-left: 6px;
  }
  .timeline-full li {
    position: relative;
    display: grid;
    grid-template-columns: 14ch minmax(0, 1fr);
    gap: var(--s-8);
    padding: var(--s-6) 0 var(--s-6) var(--s-12);
    border-bottom: 1px solid var(--c-rule);
  }
  .timeline-full li:last-child { border-bottom: 0; }
  .timeline-full li::before {
    content: '';
    position: absolute;
    left: -6px;
    top: calc(var(--s-6) + 0.5em);
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--c-brass);
    border: 2px solid var(--c-sage-soft);
    box-sizing: border-box;
    width: 12px;
    height: 12px;
    left: -6.5px;
  }
  .timeline-full li:last-child::before { background: var(--c-navy); }
  .timeline-full .date {
    font-family: var(--f-display);
    font-size: var(--t-lg);
    line-height: 1.2;
    color: var(--c-navy);
    font-variant-numeric: lining-nums;
  }
  .timeline-full .body { display: grid; gap: var(--s-1); }
  .timeline-full .title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--t-lg);
    color: var(--c-ink);
  }
  .timeline-full .title a { color: inherit; text-decoration: none; }
  .timeline-full .title a:hover { text-decoration: underline; text-decoration-color: var(--c-brass); text-underline-offset: 0.2em; }
  .timeline-full .description {
    font-family: var(--f-prose);
    color: var(--c-ink-soft);
    max-width: 56ch;
  }

  @media (max-width: 560px) {
    .timeline-full li { grid-template-columns: 1fr; gap: var(--s-2); padding-left: var(--s-6); }
  }
</style>
