---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { excludeDrafts, sortByDateDesc } from '../../lib/collections';
import { disciplineColor } from '../../lib/disciplines';

const base = import.meta.env.BASE_URL;
const articles = sortByDateDesc(
  excludeDrafts(await getCollection('articles')),
  (a) => a.data.publishedAt,
);

// Disciplines ordered by how many articles they hold, then alphabetically.
const counts = new Map<string, number>();
for (const a of articles) counts.set(a.data.discipline, (counts.get(a.data.discipline) ?? 0) + 1);
const disciplines = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const slug = (s: string) => s.toLowerCase().replace(/\W+/g, '-').replace(/^-|-$/g, '');

// One-article disciplines share an "Other" chip once there are two or more of them,
// so the row stays short however many disciplines the archive grows.
const minor = disciplines.filter(([, n]) => n === 1);
const group = minor.length >= 2;
const chipRows = [
  ...disciplines.filter(([, n]) => !group || n > 1).map(([d, n]) => ({ key: slug(d), label: d, n, ds: [d], colors: [disciplineColor(d)] })),
  ...(group
    ? [{ key: 'other', label: 'Other', n: minor.length, ds: minor.map(([d]) => d), colors: minor.map(([d]) => disciplineColor(d)) }]
    : []),
];
const swatch = (colors: string[]) =>
  colors.length === 1
    ? colors[0]
    : `linear-gradient(90deg, ${colors.map((c, i) => `${c} ${(i * 100) / colors.length}% ${((i + 1) * 100) / colors.length}%`).join(', ')})`;

const years = [...new Set(articles.map((a) => a.data.publishedAt.getUTCFullYear()))].sort((a, b) => b - a);

// Tiles of one discipline cycle through three tones, so neighbours that share a
// colour family never fuse into a single slab.
const SHADES = ['--shade:0%', '--shade:16%;--shade-c:#000', '--shade:10%;--shade-c:#fff'];
const seen = new Map<string, number>();
const shadeFor = (d: string) => {
  const k = seen.get(d) ?? 0;
  seen.set(d, k + 1);
  return SHADES[k % SHADES.length];
};
// Long titles step down a size instead of being clipped.
const lenFor = (t: string) => (t.length > 110 ? 'l' : t.length > 70 ? 'm' : 's');
---
<BaseLayout
  title="Articles"
  description="Research papers and essays written by Anthropy contributors."
>
  <section class="head band lift">
    <h1>Articles</h1>
    <p class="lede">
      Papers and essays by Anthropy contributors, across history, politics, society, economics, and culture.
    </p>
    {articles.length > 0 && (
      <div class="filters" data-filters data-disciplines={disciplines.length}>
        <p class="count" id="count" role="status" aria-live="polite">
          {articles.length} articles · {disciplines.length} disciplines
        </p>
        <div class="row">
          <p class="row-label" id="d-label">Discipline</p>
          <ul class="chips" aria-labelledby="d-label">
            <li><button type="button" class="chip" data-g="d" data-v="" aria-pressed="true">All <span>{articles.length}</span></button></li>
            {chipRows.map((c) => (
              <li>
                <button type="button" class="chip" data-g="d" data-v={c.key} data-ds={c.ds.join('|')} data-label={c.label} aria-pressed="false" style={`--sw:${swatch(c.colors)}`}>
                  <i aria-hidden="true"></i>{c.label} <span>{c.n}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>
        {years.length > 1 && (
          <div class="row">
            <p class="row-label" id="y-label">Year</p>
            <ul class="chips" aria-labelledby="y-label">
              <li><button type="button" class="chip" data-g="y" data-v="" aria-pressed="true">Any</button></li>
              {years.map((y) => (
                <li><button type="button" class="chip" data-g="y" data-v={String(y)} data-label={String(y)} aria-pressed="false">{y}</button></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}
  </section>

  {articles.length > 0 ? (
    <>
      <ul class="wall" data-wall>
        {articles.map((a, i) => (
          <li
            class={i === 0 ? 'tile lead' : i % 7 === 4 ? 'tile wide' : 'tile'}
            data-d={a.data.discipline}
            data-y={a.data.publishedAt.getUTCFullYear()}
            data-len={lenFor(a.data.title)}
            style={`--tile:${disciplineColor(a.data.discipline)};${shadeFor(a.data.discipline)}`}
          >
            <a href={`${base}articles/${a.id}/`} data-year={a.data.publishedAt.getUTCFullYear()}>
              <h2>{a.data.title}</h2>
              <p class="summary">{a.data.summary}</p>
              <p class="meta">
                <span class="who">
                  <span class="author">{a.data.author}</span>
                  <span class="where">{a.data.discipline} · {a.data.publishedAt.getUTCFullYear()}</span>
                </span>
                <svg class="go" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
              </p>
            </a>
          </li>
        ))}
      </ul>
      <div class="none" data-none hidden>
        <p>No articles match those filters.</p>
        <button type="button" class="reset" data-reset>Clear filters</button>
      </div>
    </>
  ) : (
    <p class="empty">Papers from this cycle are being finalized for publication.</p>
  )}
  <script is:inline>
    const bar = document.querySelector('[data-filters]');
    const wall = document.querySelector('[data-wall]');
    if (wall) {
      const tiles = [...wall.querySelectorAll('.tile')];

      // Wide tiles break up the rhythm. The script simulates the grid's dense packing
      // and picks a column count and set of wide tiles that leaves no empty cells, so
      // the wall always ends flush, whatever the filter or viewport.
      const holes = (n, cols, wide, big) => {
        const rows = [];
        const free = (r, c, cw, rh) => {
          for (let y = r; y < r + rh; y++) for (let x = c; x < c + cw; x++) if (rows[y]?.[x]) return false;
          return true;
        };
        for (let i = 0; i < n; i++) {
          const cw = Math.min(big && (i === 0 || wide[i]) ? 2 : 1, cols);
          const rh = big && i === 0 ? 2 : 1;
          let placed = false;
          for (let r = 0; !placed; r++) {
            for (let c = 0; c <= cols - cw && !placed; c++) {
              if (!free(r, c, cw, rh)) continue;
              for (let y = r; y < r + rh; y++) {
                rows[y] ??= [];
                for (let x = c; x < c + cw; x++) rows[y][x] = true;
              }
              placed = true;
            }
          }
        }
        return rows.reduce((n, row) => n + (cols - row.filter(Boolean).length), 0);
      };
      const fillLastRow = () => {
        const shown = tiles.filter((t) => !t.hidden);
        wall.style.gridTemplateColumns = '';
        const natural = getComputedStyle(wall).gridTemplateColumns.split(' ').length;
        const big = matchMedia('(min-width: 760px)').matches;
        let best = null;
        search: for (let cols = natural; cols >= 1; cols--) {
          const base = shown.map((_, k) => k > 0 && k % 7 === 4);
          for (const start of [base, shown.map(() => false)]) {
            for (let extra = 0; extra < shown.length; extra++) {
              const wide = [...start];
              for (let k = 1, left = extra; k < shown.length && left > 0; k++) if (!wide[k]) { wide[k] = true; left--; }
              if (holes(shown.length, cols, wide, big) === 0) { best = { cols, wide }; break search; }
            }
          }
        }
        tiles.forEach((t) => t.classList.remove('wide'));
        if (!best) return;
        shown.forEach((t, k) => t.classList.toggle('wide', best.wide[k]));
        if (best.cols < natural) wall.style.gridTemplateColumns = `repeat(${best.cols}, minmax(0, 1fr))`;
      };

      if (bar) {
        const chips = [...bar.querySelectorAll('.chip')];
        const none = document.querySelector('[data-none]');
        const count = document.getElementById('count');
        const ds = Object.fromEntries(chips.filter((c) => c.dataset.g === 'd' && c.dataset.v).map((c) => [c.dataset.v, c.dataset.ds.split('|')]));
        const labels = Object.fromEntries(chips.filter((c) => c.dataset.v).map((c) => [c.dataset.g + c.dataset.v, c.dataset.label]));
        let state = { d: '', y: '' };

        // Filters live in the URL hash, so a filtered view can be shared and Back undoes it.
        const read = () => {
          const q = new URLSearchParams(location.hash.slice(1));
          const d = q.get('d') ?? '';
          const y = q.get('y') ?? '';
          return { d: d in ds ? d : '', y: chips.some((c) => c.dataset.g === 'y' && c.dataset.v === y) ? y : '' };
        };
        const write = () => {
          const q = new URLSearchParams();
          if (state.d) q.set('d', state.d);
          if (state.y) q.set('y', state.y);
          history.pushState(null, '', location.pathname + location.search + (q.size ? '#' + q : ''));
        };

        const apply = () => {
          chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.v === state[c.dataset.g])));
          let shown = 0;
          for (const t of tiles) {
            const on = (!state.d || ds[state.d].includes(t.dataset.d)) && (!state.y || t.dataset.y === state.y);
            t.hidden = !on;
            t.classList.toggle('lead', on && shown === 0);
            if (on) shown++;
          }
          wall.hidden = shown === 0;
          none.hidden = shown !== 0;
          fillLastRow();
          const active = [state.d && labels['d' + state.d], state.y && labels['y' + state.y]].filter(Boolean);
          count.textContent = active.length
            ? `${shown} of ${tiles.length} articles · ${active.join(', ')}`
            : `${tiles.length} articles · ${bar.dataset.disciplines} disciplines`;
        };
        const set = (next) => { state = next; write(); apply(); };

        chips.forEach((c) => c.addEventListener('click', () => set({ ...state, [c.dataset.g]: c.dataset.v })));
        document.querySelector('[data-reset]').addEventListener('click', () => set({ d: '', y: '' }));
        addEventListener('popstate', () => { state = read(); apply(); });
        state = read();
        apply();
      } else {
        fillLastRow();
      }
      addEventListener('resize', fillLastRow);
    }
  </script>
</BaseLayout>



<style>
  .head {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--s-12) var(--s-8);
  }
  .head h1 { font-size: clamp(2.4rem, 12vw, var(--t-3xl)); }
  .lede {
    font-family: var(--f-prose);
    font-size: var(--t-lg);
    color: var(--c-on-navy-soft);
    max-width: 52ch;
    text-wrap: pretty;
  }
  .filters { display: grid; gap: var(--s-3); margin-top: var(--s-4); }
  .count { font-size: var(--t-sm); color: var(--c-on-navy-soft); }
  .row { display: grid; gap: var(--s-2); }
  .row-label { font-size: var(--t-xs); font-weight: 600; letter-spacing: 0.04em; color: var(--c-on-navy-soft); }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 44px;
    padding-inline: var(--s-4);
    font: 600 var(--t-sm) var(--f-ui);
    color: var(--c-on-navy);
    background: transparent;
    border: 1px solid var(--c-on-navy-soft);
    cursor: pointer;
    transition: background 160ms, color 160ms, border-color 160ms;
  }
  .chip i { width: 0.85rem; height: 0.85rem; background: var(--sw); border: 1.5px solid var(--c-on-navy); }
  .chip span { font-weight: 400; opacity: 0.75; }
  .chip:hover { background: var(--c-navy-mid); }
  .chip[aria-pressed='true'] { background: var(--c-brass); border-color: var(--c-brass); color: var(--c-navy); }
  .chip:focus-visible { outline-color: var(--c-brass); }
  @media (min-width: 760px) {
    .row { grid-template-columns: 7rem minmax(0, 1fr); align-items: center; }
  }

  .wall {
    list-style: none;
    margin: 0;
    /* Break out of the page shell so the wall meets both viewport edges. */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    grid-auto-flow: dense;
    gap: 3px;
    margin-bottom: calc(var(--s-24) * -1); /* cancel the footer's top margin so the wall meets it */
  }
  .wall[hidden] { display: none; }

  :global(html) { overflow-x: clip; }
  .tile[hidden] { display: none; }
  .tile {
    display: grid;
    /* Same discipline, three tones: neighbours never fuse into one slab. */
    --tile-bg: color-mix(in srgb, var(--tile), var(--shade-c, #000) var(--shade, 0%));
  }
  .tile a {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 18rem;
    padding: var(--s-6);
    color: #fff;
    background: var(--tile-bg);
    text-decoration: none;
    transition: transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 240ms;
  }
  /* The publication year, set large and faint behind the text. */
  .tile a::after {
    content: attr(data-year);
    position: absolute;
    right: -0.05em;
    bottom: -0.2em;
    z-index: -1;
    font: 700 6rem/1 var(--f-display);
    color: rgb(255 255 255 / 0.055);
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tile a:hover, .tile a:focus-visible { transform: translateY(-4px); box-shadow: 0 14px 28px rgba(21, 34, 47, 0.22); }
  .tile a:hover::after, .tile a:focus-visible::after { transform: translate(-0.1em, -0.1em); }
  .tile a:focus-visible { outline: 2px solid var(--c-brass); outline-offset: 3px; }
  .tile h2 {
    font-size: var(--t-lg);
    line-height: 1.22;
    color: #fff;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  /* Longer titles step down a size so they are shown in full, not clipped. */
  .tile[data-len='m'] h2 { font-size: 1.15rem; -webkit-line-clamp: 8; }
  .tile[data-len='l'] h2 { font-size: var(--t-base); -webkit-line-clamp: 10; }

  .meta { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-3); margin-top: auto; }
  .who { display: grid; gap: 2px; }
  .author { font-weight: 600; font-size: var(--t-sm); }
  .where { font-size: var(--t-xs); color: rgb(255 255 255 / 0.82); }
  .go { flex: none; opacity: 0.7; transition: transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1), opacity 240ms; }
  .tile a:hover .go, .tile a:focus-visible .go { opacity: 1; transform: translateX(4px); }

  /* On a plain tile the summary slides up over the lower part on hover or focus. */
  .summary {
    position: absolute;
    inset: auto 0 0 0;
    padding: var(--s-6);
    font-family: var(--f-prose);
    font-size: var(--t-sm);
    line-height: 1.5;
    background: color-mix(in srgb, var(--tile-bg) 82%, #000);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 280ms cubic-bezier(0.2, 0.7, 0.2, 1);
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tile:not(.lead):not(.wide) a:hover .summary,
  .tile:not(.lead):not(.wide) a:focus-visible .summary { clip-path: inset(0); }

  /* Lead and wide tiles have the room, and touch screens have no hover: show it at rest. */
  .tile.lead .summary,
  .tile.wide .summary {
    position: static;
    padding: 0;
    background: none;
    clip-path: none;
    color: rgb(255 255 255 / 0.9);
    -webkit-line-clamp: 3;
  }
  .tile.lead .summary { font-size: var(--t-base); max-width: 44ch; -webkit-line-clamp: 6; }
  .tile.wide .summary { max-width: 56ch; }
  @media (hover: none) {
    .summary {
      position: static;
      padding: 0;
      background: none;
      clip-path: none;
      color: rgb(255 255 255 / 0.9);
      -webkit-line-clamp: 3;
    }
  }
  .tile.lead h2 { font-size: var(--t-xl); }
  .tile.lead[data-len='l'] h2 { font-size: var(--t-lg); }
  .tile.lead a, .tile.wide a { justify-content: flex-start; }

  @media (min-width: 760px) {
    .tile.lead { grid-column: span 2; grid-row: span 2; }
    .tile.lead a { padding: var(--s-8); }
    .tile.lead h2 { font-size: var(--t-2xl); -webkit-line-clamp: 5; }
    .tile.lead[data-len='m'] h2 { font-size: var(--t-xl); }
    .tile.lead[data-len='l'] h2 { font-size: var(--t-xl); }
    .tile.lead a::after { font-size: 11rem; }
    .tile.wide:not(.lead) { grid-column: span 2; }
  }

  .none { padding-block: var(--s-16); display: grid; gap: var(--s-4); justify-items: start; color: var(--c-ink-soft); }
  .none[hidden] { display: none; }
  .reset {
    min-height: 44px;
    padding-inline: var(--s-6);
    font: 600 var(--t-sm) var(--f-ui);
    color: var(--c-on-navy);
    background: var(--c-navy);
    border: 0;
    cursor: pointer;
  }
  .reset:hover { background: var(--c-navy-mid); }
  .empty { padding-block: var(--s-16); color: var(--c-ink-soft); }

  @media (prefers-reduced-motion: reduce) {
    .tile a, .tile a::after, .summary, .go { transition: none; }
    .tile a:hover, .tile a:focus-visible { transform: none; }
    .tile a:hover .go, .tile a:focus-visible .go { transform: none; }
  }
</style>
