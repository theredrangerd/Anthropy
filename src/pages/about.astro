---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="About Anthropy"
  description="Anthropy is a student-led humanities research organization based at UWC South East Asia's Dover Campus, with international reach."
>
  <section class="masthead band lift">
    <div class="masthead-title">
      <h1>About Anthropy</h1>
      <p class="statement">
        Empowering students to chase their curiosity.
      </p>
    </div>
    <dl class="masthead-facts">
      <div><dt>Founded</dt><dd class="year">{site.established}</dd></div>
      <div><dt>Based at</dt><dd>{site.basedAt}</dd></div>
    </dl>
  </section>

  <div class="opening">
    <figure class="opening-photo">
      <img
        src={`${base}about/globe.jpg`}
        alt="The Anthropy emblem: a globe beneath the name Anthropy"
        width="1162"
        height="1000"
        loading="lazy"
      />
    </figure>
    <div class="opening-text prose">
      <p>
        Anthropy is a student-led organization for humanities research. We are based at UWC
        South East Asia's Dover Campus, with international reach — contributors have joined from
        UWC East and UWC Changshu China, dialing into mentoring sessions remotely, with more
        international members joining this year.
      </p>
      <p class="lede">
        We exist to foster early intellectual curiosity in the humanities — the years between
        being interested in a subject and being equipped to study it properly, which secondary
        school rarely bridges. A student curious about political theory or economic history is
        usually told to wait until university. We think that wait is longer than it needs to be.
      </p>
    </div>
  </div>

  <section class="story band slate" id="timeline" aria-labelledby="story-h">
    <h2 id="story-h">Our story so far</h2>
    <Timeline variant="full" />
  </section>

  <section class="block" aria-labelledby="do-h">
    <h2 id="do-h">What we do</h2>
    <div class="do-pair">
      <article class="do-item">
        <a class="do-media photo" href={`${base}in2academia/`} tabindex="-1" aria-hidden="true">
          <img src={`${base}about/workshop.jpg`} alt="" width="1400" height="1050" loading="lazy" />
        </a>
        <div class="do-body">
          <h3><a href={`${base}in2academia/`}>In2Academia</a></h3>
          <p>
            Over ten weeks and ten workshops, students move from a vague interest to a defined
            research question to a finished paper, working alongside academic mentors. Strong
            papers are published in our academic journal.
          </p>
        </div>
      </article>
      <article class="do-item">
        <a class="do-media photo" href={`${base}events/`} tabindex="-1" aria-hidden="true">
          <img src={`${base}about/forum.jpg`} alt="" width="1400" height="932" loading="lazy" />
        </a>
        <div class="do-body">
          <h3><a href={`${base}events/`}>Humanities Focus</a></h3>
          <p>
            We bring researchers, academics, and professionals in to speak directly with students —
            not as a careers talk, but as a conversation about what the work actually involves.
          </p>
        </div>
      </article>
    </div>
  </section>

  <section class="close band lift" aria-label="Meet the team">
    <p class="close-line">Leadership changes every year. The people behind this one are listed.</p>
    <a class="btn" href={`${base}leadership/`}>Meet the team</a>
  </section>
</BaseLayout>

<style>
  .band.slate { --band: var(--c-sage-soft); }
  .band.lift .btn { background: var(--c-brass); border-color: var(--c-brass); color: var(--c-navy); }
  .band.lift .btn:hover { background: #C7B499; border-color: #C7B499; }
  .band.lift :focus-visible { outline-color: var(--c-brass); }

  .masthead {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--s-12);
    align-items: end;
    padding-block: var(--s-16) var(--s-12);
  }
  .masthead-title { display: grid; gap: var(--s-6); }
  .masthead h1 { font-size: clamp(2.4rem, 9vw, 4.5rem); overflow-wrap: anywhere; }
  .statement {
    font-family: var(--f-display);
    font-size: var(--t-xl);
    line-height: 1.3;
    max-width: 24ch;
    color: var(--c-on-navy-soft);
    text-wrap: balance;
  }
  .masthead-facts { margin: 0; display: grid; gap: var(--s-6); }
  .masthead-facts > div { border-top: 1px solid var(--c-brass); padding-top: var(--s-3); display: grid; gap: var(--s-1); }
  .masthead-facts dt {
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-on-navy-soft);
  }
  .masthead-facts dd { margin: 0; font-family: var(--f-display); font-size: var(--t-lg); }
  .masthead-facts .year { font-size: 4rem; line-height: 1; color: var(--c-brass); font-variant-numeric: lining-nums; }

  .opening {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-16);
    align-items: center;
    padding-block: var(--s-16);
  }
  .opening-photo { margin: 0; justify-self: center; width: 100%; }
  .opening-photo img {
    width: 100%;
    aspect-ratio: 1162 / 1000;
    object-fit: cover;
    box-shadow: 0 14px 34px rgba(21, 34, 47, 0.2);
  }
  .opening-text { display: grid; gap: var(--s-8); }
  .opening-text > * + * { margin-top: 0; }
  .opening-text p:first-child { color: var(--c-ink-soft); max-width: 52ch; }
  .lede {
    font-family: var(--f-display);
    font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.6rem);
    line-height: 1.4;
    letter-spacing: -0.005em;
    color: var(--c-navy);
    text-wrap: pretty;
    padding-top: var(--s-8);
    border-top: 1px solid var(--c-brass);
  }
  .lede::first-letter {
    float: left;
    font-weight: 700;
    font-size: 2.9em;
    line-height: 0.82;
    padding: 0.04em 0.08em 0 0;
    color: var(--c-brass);
  }

  .story { display: grid; gap: var(--s-8); padding-block: var(--s-16); }

  .block { display: grid; gap: var(--s-8); padding-block: var(--s-16); }
  .do-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-12); }
  .do-item { display: grid; grid-template-rows: auto 1fr; gap: var(--s-6); }
  .do-media {
    display: block;
    background: var(--c-navy);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    position: relative;
  }
  .do-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .do-item:hover .do-media.photo img { transform: scale(1.03); }
  .do-body { display: grid; gap: var(--s-3); align-content: start; border-top: 2px solid var(--c-brass); padding-top: var(--s-4); }
  .do-body h3 { font-size: var(--t-xl); }
  .do-body h3 a { text-decoration: none; }
  .do-body h3 a:hover { text-decoration: underline; text-decoration-color: var(--c-brass); text-underline-offset: 0.2em; }
  .do-body p { font-family: var(--f-prose); color: var(--c-ink-soft); max-width: 46ch; }

  .close {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    padding-block: var(--s-12);
    margin-bottom: calc(var(--s-24) * -1);
  }
  .close-line { font-family: var(--f-display); font-size: var(--t-xl); max-width: 30ch; text-wrap: balance; }
  .close .btn { min-height: 44px; display: inline-flex; align-items: center; }

  @media (max-width: 720px) {
    .masthead { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); padding-block: var(--s-12) var(--s-8); }
    .opening { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); padding-block: var(--s-12); }
    .do-pair { grid-template-columns: minmax(0, 1fr); gap: var(--s-12); }
  }
  @media (prefers-reduced-motion: reduce) {
    .do-media img { transition: none; }
    .do-item:hover .do-media.photo img { transform: none; }
  }
</style>
