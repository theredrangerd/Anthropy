---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const years = (await getCollection('leadership')).sort(
  (a, b) => b.data.startYear - a.data.startYear,
);
const current = years.find((y) => y.data.current) ?? years[0];
const previous = years.filter((y) => y.id !== current?.id);

const inTier = (tier: 'lead' | 'core' | 'mentor') =>
  current?.data.members.filter((m) => m.tier === tier) ?? [];
const leads = inTier('lead');
const core = inTier('core');
const mentors = inTier('mentor');

// Bios that still carry the "fuller bio" stub are shown without it: the
// stub is a note to the editors, not copy for readers.
const bioOf = (bio?: string) =>
  bio?.replace(/\s*A fuller bio is on its way\.?\s*$/, '').trim() || undefined;
---
<BaseLayout
  title="Leadership"
  description="The students who lead Anthropy, and those who led it before them."
>
  <section class="masthead band lift" aria-labelledby="lead-h">
    <header class="masthead-head">
      <h1 id="lead-h">Leadership</h1>
      {current && (
        <p class="masthead-year">
          <span class="year">{current.data.academicYear}</span>
          <span class="year-note">Leadership changes every year. These are the people behind this one.</span>
        </p>
      )}
    </header>

    {leads.length > 0 && (
      <ul class="chairs">
        {leads.map((m) => (
          <li class="chair">
            <figure class="plate">
              {m.photo ? (
                <img
                  src={`${base}${m.photo.replace(/^\//, '')}`}
                  alt={m.name}
                  width="420"
                  height="528"
                  loading="lazy"
                  style={`object-position: ${m.photoPosition}`}
                />
              ) : (
                <span class="initial" aria-hidden="true">{m.name.charAt(0)}</span>
              )}
            </figure>
            <div class="chair-text">
              <p class="chair-name">{m.name}</p>
              <p class="chair-role">{m.role}</p>
              {bioOf(m.bio) && <p class="chair-bio">{bioOf(m.bio)}</p>}
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  {years.length > 1 && (
    <nav class="years" aria-label="Leadership years">
      <ul>
        {years.map((y) => (
          <li><a href={`#year-${y.data.startYear}`}>{y.data.academicYear}</a></li>
        ))}
      </ul>
    </nav>
  )}

  {years.length === 0 && <p class="empty">The leadership roster is being recorded.</p>}
  {current && current.data.members.length === 0 && (
    <p class="empty">This year's team is being confirmed.</p>
  )}

  {core.length > 0 && (
    <section class="block" id={`year-${current?.data.startYear}`} aria-labelledby="core-h">
      <h2 id="core-h">Heads of the team</h2>
      <ul class="people heads">
        {core.map((m) => (
          <li class="head">
            <figure class="plate">
              {m.photo ? (
                <img
                  src={`${base}${m.photo.replace(/^\//, '')}`}
                  alt={m.name}
                  width="600"
                  height="760"
                  loading="lazy"
                  style={`object-position: ${m.photoPosition}`}
                />
              ) : (
                <span class="initial" aria-hidden="true">{m.name.charAt(0)}</span>
              )}
            </figure>
            <div class="head-text">
              <p class="head-name">{m.name}</p>
              <p class="role">{m.role}</p>
              {bioOf(m.bio) && <p class="bio">{bioOf(m.bio)}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {mentors.length > 0 && (
    <section class="block mentors band slate" aria-labelledby="mentors-h">
      <h2 id="mentors-h">Mentors</h2>
      <ul class="people plates">
        {mentors.map((m) => (
          <li class="mentor">
            <figure class="plate">
              {m.photo ? (
                <img
                  src={`${base}${m.photo.replace(/^\//, '')}`}
                  alt={m.name}
                  width="640"
                  height="800"
                  loading="lazy"
                  style={`object-position: ${m.photoPosition}`}
                />
              ) : (
                <span class="initial" aria-hidden="true">{m.name.charAt(0)}</span>
              )}
            </figure>
            <p class="mentor-name">{m.name}</p>
            <p class="role">{m.role}</p>
            {bioOf(m.bio) && <p class="bio">{bioOf(m.bio)}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {previous.map((y) => (
    <section class="block archive" id={`year-${y.data.startYear}`} aria-labelledby={`h-${y.data.startYear}`}>
      <h2 id={`h-${y.data.startYear}`}>{y.data.academicYear}</h2>
      {y.data.members.length === 0 ? (
        <p class="empty">Roster not yet recorded.</p>
      ) : (
        <ul class="roll">
          {y.data.members.map((m) => (
            <li>
              <span class="roll-name">{m.name}</span>
              <span class="roll-role">{m.role}</span>
              <span class="roll-campus">{m.campus}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
</BaseLayout>

<style>
  .band.slate { --band: var(--c-sage-soft); }

  /* The masthead is the page's statement: the co-chairs sit on the navy, set
     at the scale a journal gives its editors. */
  .masthead {
    --wide: min(1320px, 100vw - 3rem);
    display: grid;
    gap: var(--s-16);
    padding-block: var(--s-16) var(--s-24);
  }
  /* The masthead's content breaks out of the page column so the co-chairs
     can use the width of the screen. */
  .masthead > * {
    width: var(--wide);
    margin-left: calc(50% - var(--wide) / 2);
  }
  .masthead-head {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--s-12);
    align-items: end;
  }
  .masthead h1 { font-size: clamp(2.4rem, 9vw, 4.5rem); overflow-wrap: anywhere; }
  .masthead-year {
    display: grid;
    gap: var(--s-3);
    border-top: 1px solid var(--c-brass);
    padding-top: var(--s-3);
  }
  .masthead-year .year {
    font-family: var(--f-display);
    font-size: 2.6rem;
    line-height: 1;
    color: var(--c-brass);
    font-variant-numeric: lining-nums;
  }
  .year-note { font-size: var(--t-sm); color: var(--c-on-navy-soft); max-width: 34ch; }

  /* Co-chairs: one ruled row each, portrait on the left, name over bio on
     the right. */
  .chairs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-12);
  }
  .chair {
    position: relative;
    display: grid;
    grid-template-columns: clamp(11rem, 26%, 22rem) minmax(0, 1fr);
    column-gap: clamp(var(--s-8), 4vw, var(--s-16));
    align-items: start;
    padding-top: var(--s-8);
  }
  .chair::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--c-brass);
    transform-origin: left;
    animation: rule-draw 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .chair:nth-child(2)::before { animation-delay: 140ms; }
  .chair .plate {
    width: 100%;
    margin: 0;
    background: var(--c-navy);
    box-shadow: 0 0 0 1px rgb(181 158 127 / 0.4);
  }
  .chair .plate .initial { font-size: clamp(4rem, 8vw, 7rem); }
  .chair-text { display: grid; gap: var(--s-4); align-content: start; }
  .chair-name {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 1.2rem + 3.4vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
    color: var(--c-on-navy);
    animation: name-rise 800ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both;
  }
  .chair:nth-child(2) .chair-name { animation-delay: 260ms; }
  .chair-role {
    font-family: var(--f-display);
    font-style: italic;
    font-size: var(--t-lg);
    color: var(--c-brass);
    margin-top: calc(var(--s-2) * -1);
  }
  /* Two columns of ~60 characters each: the width is used without a line
     that runs the length of the screen. */
  .chair-bio {
    font-family: var(--f-prose);
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--c-on-navy-soft);
    column-width: 26rem;
    column-gap: var(--s-12);
    padding-top: var(--s-6);
    border-top: 1px solid rgb(181 158 127 / 0.35);
  }
  @keyframes rule-draw { from { transform: scaleX(0); } }
  @keyframes name-rise { from { opacity: 0; transform: translateY(14px); } }

  .years ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    list-style: none;
    margin: 0;
    padding: var(--s-6) 0 0;
    font-size: var(--t-sm);
  }

  .block { display: grid; gap: var(--s-8); padding-block: var(--s-16); }
  .block h2 { font-size: var(--t-2xl); color: var(--c-navy); }
  .empty { font-family: var(--f-prose); font-style: italic; color: var(--c-ink-faint); padding-block: var(--s-8); }

  .people { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-12); }
  .role {
    font-size: var(--t-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-faint);
  }
  .bio { font-family: var(--f-prose); color: var(--c-ink-soft); max-width: 44ch; }

  /* Heads: the same ruled column the About page gives each programme. */
  .heads { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-12); }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
    border-top: 2px solid var(--c-brass);
    padding-top: var(--s-4);
  }
  .head .plate { margin: 0; }
  .head .plate .initial { font-size: 4.5rem; }
  .head-text { display: grid; gap: var(--s-2); align-content: start; }
  .head-name { font-family: var(--f-display); font-weight: 700; font-size: var(--t-2xl); line-height: 1.1; color: var(--c-navy); }
  .head .bio { margin-top: var(--s-2); }

  /* Mentors: square-cornered plates, as the journal prints its contributors. */
  .mentors { margin-top: var(--s-8); margin-bottom: calc(var(--s-24) * -1); }
  .plates { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-8); }
  .mentor { display: grid; gap: var(--s-2); align-content: start; }
  .plate {
    margin: 0 0 var(--s-3);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--c-navy);
    display: grid;
    grid-template: 100% / 100%;
    place-items: center;
  }
  .plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .mentor:hover .plate img, .head:hover .plate img { transform: scale(1.03); }
  .plate .initial {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 7rem;
    line-height: 1;
    color: var(--c-brass);
  }
  .mentor-name { font-family: var(--f-display); font-weight: 700; font-size: var(--t-xl); line-height: 1.15; color: var(--c-navy); }
  .mentor .bio { font-size: var(--t-sm); margin-top: var(--s-2); }

  /* Past years: a ruled roll, name left, role right. */
  .roll { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--c-brass); }
  .roll li {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--s-4);
    align-items: baseline;
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--c-rule);
  }
  .roll-name { font-family: var(--f-display); font-size: var(--t-lg); }
  .roll-role { font-size: var(--t-sm); color: var(--c-ink-soft); }
  .roll-campus { font-size: var(--t-xs); color: var(--c-ink-faint); text-align: right; }

  @media (max-width: 860px) {
    .masthead { gap: var(--s-12); padding-block: var(--s-12); }
    .masthead-head { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); }
    .chair { grid-template-columns: minmax(0, 10rem) minmax(0, 1fr); column-gap: var(--s-8); }
    .plates { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .heads, .plates { grid-template-columns: minmax(0, 1fr); }
    .chair { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-6); }
    .chair .plate { max-width: 12rem; }
    .chair-bio { column-width: auto; column-count: 1; }
    .head { grid-template-columns: minmax(0, 7rem) minmax(0, 1fr); gap: var(--s-4); }
    .plate { aspect-ratio: 1 / 1; }
    .roll li { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); }
    .roll-campus { text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) {
    .plate img { transition: none; }
    .mentor:hover .plate img, .head:hover .plate img { transform: none; }
  }
</style>
