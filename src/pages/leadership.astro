---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const years = (await getCollection('leadership')).sort(
  (a, b) => b.data.startYear - a.data.startYear,
);
const current = years.find((y) => y.data.current) ?? years[0];
const previous = years.filter((y) => y.id !== current?.id);

const tierGroups = [
  { tier: 'lead', members: current?.data.members.filter((m) => m.tier === 'lead') ?? [] },
  { tier: 'core', members: current?.data.members.filter((m) => m.tier === 'core') ?? [] },
  { tier: 'mentor', members: current?.data.members.filter((m) => m.tier === 'mentor') ?? [] },
];
---
<BaseLayout
  title="Leadership"
  description="The students who lead Anthropy, and those who led it before them."
>
  <section class="head">
    <p class="eyebrow">The team</p>
    <h1>Leadership</h1>
  </section>

  {years.length > 1 && (
    <nav class="years" aria-label="Leadership years">
      <ul>
        {years.map((y) => (
          <li><a href={`#year-${y.data.startYear}`}>{y.data.academicYear}</a></li>
        ))}
      </ul>
    </nav>
  )}

  {years.length === 0 && (
    <p class="empty">The leadership roster is being recorded.</p>
  )}

  {current && (
    <section class="year" id={`year-${current.data.startYear}`}>
      <h2>{current.data.academicYear}</h2>
      {current.data.members.length === 0 ? (
        <p class="empty">This year's team is being confirmed.</p>
      ) : (
        <ul class="bento">
          {tierGroups.map(({ tier, members }) =>
            members.map((m, i) => (
              <li
                class="tile"
                data-tier={tier}
                tabindex="0"
                class:list={{ alt: tier === 'mentor' && i % 2 === 1 }}
              >
                <div class="portrait">
                  {m.photo ? (
                    <img class="avatar" src={`${import.meta.env.BASE_URL}${m.photo.replace(/^\//, '')}`} alt={m.name} style={`object-position: ${m.photoPosition}`} />
                  ) : (
                    <span class="avatar placeholder" aria-hidden="true">{m.name.charAt(0)}</span>
                  )}
                </div>
                <span class="role-tag">{m.role}</span>
                <p class="name">{m.name}</p>
                {m.bio && (
                  <div class="bio-wrap">
                    <p class="bio">{m.bio}</p>
                  </div>
                )}
              </li>
            )),
          )}
        </ul>
      )}
    </section>
  )}

  {previous.map((y) => (
    <section class="year" id={`year-${y.data.startYear}`}>
      <h2>{y.data.academicYear}</h2>
      {y.data.members.length === 0 ? (
        <p class="empty">Roster not yet recorded.</p>
      ) : (
        <ul class="people auto-grid">
          {y.data.members.map((m) => (
            <li>
              <p class="name">{m.name}</p>
              <p class="role">{m.role}</p>
              <p class="campus">{m.campus}</p>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
</BaseLayout>

<script>
  // Progressive enhancement: the bio is real text in the DOM from the
  // start — readable without JS, by search engines, and by anyone with
  // prefers-reduced-motion on. Only when JS runs *and* motion is fine do
  // we clear it and retype it character-by-character on first hover or
  // keyboard focus, while a `.revealed` class (added at the same moment)
  // drives the tile's box-grow transition in CSS.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const CHARS_PER_SECOND = 45;

  const tiles = document.querySelectorAll<HTMLElement>('.tile');
  for (const tile of tiles) {
    const bio = tile.querySelector<HTMLElement>('.bio');
    if (!bio || reducedMotion) continue;

    const text = bio.textContent ?? '';
    bio.textContent = '';
    const caret = document.createElement('span');
    caret.className = 'caret';
    bio.after(caret);

    let revealed = false;
    const reveal = () => {
      if (revealed) return;
      revealed = true;
      tile.classList.add('revealed');
      let i = 0;
      const step = () => {
        bio.textContent = text.slice(0, i);
        i++;
        if (i <= text.length) {
          setTimeout(step, 1000 / CHARS_PER_SECOND);
        } else {
          caret.remove();
        }
      };
      step();
    };
    tile.addEventListener('mouseenter', reveal, { once: true });
    tile.addEventListener('focusin', reveal, { once: true });
  }
</script>

<style>
  .head { display: grid; gap: var(--s-4); padding-block: var(--s-16) var(--s-8); }
  .years ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    list-style: none;
    margin: 0 0 var(--s-8);
    padding: 0;
    font-size: var(--t-sm);
  }
  .year { padding-block: var(--s-8); border-top: 1px solid var(--c-rule); display: grid; gap: var(--s-6); }

  /* Past years: plain uniform grid. */
  .people {
    --auto-grid-min: 220px;
  }
  .people li { display: grid; gap: var(--s-1); }
  .people .name { font-family: var(--f-display); font-size: var(--t-lg); }
  .people .role { font-size: var(--t-sm); color: var(--c-sage); }
  .people .campus { font-size: var(--t-xs); color: var(--c-ink-faint); }
  .empty { font-family: var(--f-prose); font-style: italic; color: var(--c-ink-faint); }

  /* Current year: bento grid. Six columns; tile size (via column span and
     padding/type scale) reflects tier, not document order. Auto-placement
     relies on tiles being rendered grouped by tier: two leads (span 3 each,
     one row), two core (span 3 each, one row), three mentors (span 2 each,
     one row). */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--s-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tile {
    position: relative;
    overflow: hidden;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--s-2);
    text-align: center;
    border: 1px solid var(--c-rule);
    border-radius: 6px;
  }

  /* No min-height: each tile starts sized to just its photo, role tag,
     and name, then grows as the bio-wrap below expands on reveal. */
  .tile[data-tier='lead'] {
    grid-column: span 3;
    padding: var(--s-8);
    background: var(--c-sage-soft);
  }
  .tile[data-tier='core'] {
    grid-column: span 3;
    padding: var(--s-6);
    background: var(--c-rust-soft);
  }
  .tile[data-tier='mentor'] {
    grid-column: span 2;
    padding: var(--s-4);
    background: var(--c-surface);
  }
  .tile[data-tier='mentor'].alt { background: var(--c-sunk); }

  /* The photo (or placeholder initial) is the tile's centerpiece: bigger
     and higher up the hierarchy than the name/role text below it. */
  .portrait { margin-bottom: var(--s-2); }

  .avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--c-surface);
    box-shadow: 0 4px 12px rgba(20, 36, 58, 0.2);
    font-family: var(--f-display);
    color: var(--c-ink-faint);
    background: var(--c-sunk);
  }
  .tile[data-tier='lead'] .avatar { width: 10rem; height: 10rem; font-size: var(--t-2xl); }
  .tile[data-tier='core'] .avatar { width: 7.75rem; height: 7.75rem; font-size: var(--t-xl); }
  .tile[data-tier='mentor'] .avatar { width: 6.25rem; height: 6.25rem; font-size: var(--t-lg); }

  /* Role tag is always visible, never animated — only the bio types in. */
  .role-tag {
    font-family: var(--f-ui);
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
    border: 1px solid var(--c-rule);
    border-radius: 999px;
    padding: var(--s-1) var(--s-3);
    background: var(--c-ground);
  }
  .tile[data-tier='lead'] .role-tag { transform: rotate(-2deg); }

  .tile .name { font-family: var(--f-display); }
  .tile[data-tier='lead'] .name { font-size: var(--t-xl); }
  .tile[data-tier='core'] .name { font-size: var(--t-lg); }
  .tile[data-tier='mentor'] .name { font-size: var(--t-base); }

  /* Collapsed to zero height until revealed — the grid-template-rows
     0fr → 1fr trick, so the tile visibly grows to fit the bio as it types
     in rather than snapping straight to its final size. */
  .bio-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s ease;
  }
  .tile.revealed .bio-wrap { grid-template-rows: 1fr; }
  .bio {
    overflow: hidden;
    font-family: var(--f-prose);
    color: var(--c-ink-soft);
    max-width: 42ch;
  }
  .tile[data-tier='mentor'] .bio { font-size: var(--t-sm); }

  /* Blinking caret shown only while a bio is actively being typed —
     appended after .bio by script, removed once typing finishes. */
  .caret {
    display: inline-block;
    width: 1px;
    height: 1em;
    margin-left: 2px;
    background: currentColor;
    color: var(--c-ink-soft);
    vertical-align: -0.15em;
    animation: caret-blink 0.8s steps(1) infinite;
  }
  @keyframes caret-blink { 50% { opacity: 0; } }

  /* The script deliberately skips wiring up any tile when motion is
     reduced (nothing to animate), which means it never adds the
     `.revealed` class either. Without this, a collapsed bio-wrap would
     stay collapsed forever, unreachable by hover or focus. */
  @media (prefers-reduced-motion: reduce) {
    .bio-wrap { grid-template-rows: 1fr; }
  }

  @media (max-width: 720px) {
    .bento { grid-template-columns: 1fr; }
    .tile[data-tier='lead'],
    .tile[data-tier='core'],
    .tile[data-tier='mentor'] {
      grid-column: 1 / -1;
    }
  }
</style>
