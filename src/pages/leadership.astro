---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const years = (await getCollection('leadership')).sort(
  (a, b) => b.data.startYear - a.data.startYear,
);
const current = years.find((y) => y.data.current) ?? years[0];
const previous = years.filter((y) => y.id !== current?.id);

const inTier = (tier: 'lead' | 'core' | 'mentor') =>
  current?.data.members.filter((m) => m.tier === tier) ?? [];
const leads = inTier('lead');
const core = inTier('core');
const mentors = inTier('mentor');

// Bios that still carry the "fuller bio" stub are shown without it: the
// stub is a note to the editors, not copy for readers.
const bioOf = (bio?: string) =>
  bio?.replace(/\s*A fuller bio is on its way\.?\s*$/, '').trim() || undefined;

// Bios may carry [text](url) links: site-relative paths get the base path,
// everything else is escaped and left as written.
const esc = (t: string) =>
  t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const bioHtml = (bio?: string) => {
  const text = bioOf(bio);
  if (!text) return undefined;
  return esc(text).replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_, label, href) => {
    const url = href.startsWith('/') ? `${base}${href.replace(/^\//, '')}` : href;
    return `<a href="${url}">${label}</a>`;
  });
};
---
<BaseLayout
  title="Leadership"
  description="The students who lead Anthropy, and those who led it before them."
>
  <section class="masthead band lift" aria-labelledby="lead-h">
    <header class="masthead-head">
      <h1 id="lead-h">Leadership</h1>
      {current && (
        <p class="masthead-year">
          <span class="year">{current.data.academicYear.split("–")[0]}<span class="dash">–</span>{current.data.academicYear.split("–")[1]}</span>
        </p>
      )}
    </header>

    {leads.length > 0 && (
      <ul class="chairs">
        {leads.map((m) => (
          <li class="chair">
            <figure class={m.photo ? 'plate' : 'plate empty-plate'}>
              {m.photo ? (
                <img
                  src={`${base}${m.photo.replace(/^\//, '')}`}
                  alt={m.name}
                  width="420"
                  height="528"
                  loading="lazy"
                  style={`object-position: ${m.photoPosition}`}
                />
              ) : (
                <span class="initial" aria-hidden="true">{m.name.charAt(0)}</span>
              )}
            </figure>
            <div class="chair-text">
              <h2 class="chair-name">{m.name}</h2>
              <p class="role">{m.role}</p>
              {bioHtml(m.bio) && <p class="chair-bio" set:html={bioHtml(m.bio)} />}
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>

  {years.length > 1 && (
    <nav class="years" aria-label="Leadership years">
      <ul>
        {years.map((y) => (
          <li><a href={`#year-${y.data.startYear}`}>{y.data.academicYear}</a></li>
        ))}
      </ul>
    </nav>
  )}

  {years.length === 0 && <p class="empty">The leadership roster is being recorded.</p>}
  {current && current.data.members.length === 0 && (
    <p class="empty">This year's team is being confirmed.</p>
  )}

  {core.length > 0 && (
    <section class="block" id={`year-${current?.data.startYear}`} aria-labelledby="core-h">
      <h2 id="core-h">Heads of the team</h2>
      <ul class="people heads">
        {core.map((m) => (
          <li class="head">
            <figure class={m.photo ? 'plate' : 'plate empty-plate'}>
              {m.photo ? (
                <img
                  src={`${base}${m.photo.replace(/^\//, '')}`}
                  alt={m.name}
                  width="600"
                  height="760"
                  loading="lazy"
                  style={`object-position: ${m.photoPosition}`}
                />
              ) : (
                <span class="initial" aria-hidden="true">{m.name.charAt(0)}</span>
              )}
            </figure>
            <div class="head-text">
              <h3 class="head-name">{m.name}</h3>
              <p class="role">{m.role}</p>
              {bioHtml(m.bio) && <p class="bio" set:html={bioHtml(m.bio)} />}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  {mentors.length > 0 && (
    <section class="block mentors band slate" aria-labelledby="mentors-h">
      <h2 id="mentors-h">Mentors</h2>
      <ul class="people plates">
        {mentors.map((m) => (
          <li class="mentor">
            <figure class={m.photo ? 'plate' : 'plate empty-plate'}>
              {m.photo ? (
                <img
                  src={`${base}${m.photo.replace(/^\//, '')}`}
                  alt={m.name}
                  width="640"
                  height="800"
                  loading="lazy"
                  style={`object-position: ${m.photoPosition}`}
                />
              ) : (
                <span class="initial" aria-hidden="true">{m.name.charAt(0)}</span>
              )}
            </figure>
            <h3 class="mentor-name">{m.name}</h3>
            <p class="role">{m.role}</p>
            {bioHtml(m.bio) && <p class="bio" set:html={bioHtml(m.bio)} />}
          </li>
        ))}
      </ul>
    </section>
  )}

  {previous.length > 0 && (
    <section class="block alumni-head" aria-labelledby="alumni-h">
      <h2 id="alumni-h">Alumni</h2>
    </section>
  )}

  {previous.map((y) => (
    <section class="block archive" id={`year-${y.data.startYear}`} aria-labelledby={`h-${y.data.startYear}`}>
      <h3 id={`h-${y.data.startYear}`}>{y.data.academicYear}</h3>
      {y.data.members.length === 0 ? (
        <p class="empty">Roster not yet recorded.</p>
      ) : (
        <ul class="roll">
          {y.data.members.map((m) => (
            <li>
              <span class="roll-name">{m.name}</span>
              <span class="roll-role">{m.role}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
</BaseLayout>

<style>
  .band.slate { --band: var(--c-sage-soft); }

  /* Photo size follows tier: chairs, then heads, then mentors. */
  :global(:root) { --photo-chair: 15rem; --photo-head: 11rem; --photo-mentor: 9.5rem; }

  .masthead { display: grid; gap: var(--s-16); padding-block: var(--s-16) var(--s-24); }
  /* Title and academic year share one baseline at one size: the year is the other half of the masthead. */
  .masthead-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: var(--s-12);
    row-gap: var(--s-2);
  }
  .masthead h1 { font-size: clamp(2.4rem, 9vw, 4.5rem); line-height: 1; overflow-wrap: anywhere; }
  .masthead-year { margin: 0; line-height: 1; }
  .masthead-year .year {
    font-family: var(--f-display);
    font-size: clamp(2.4rem, 9vw, 4.5rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--c-brass);
    font-variant-numeric: lining-nums;
    white-space: nowrap;
  }
  .masthead-year .dash { margin-inline: 0.04em; opacity: 0.6; }
  .masthead-year { padding-right: 0.08em; }

  /* One role voice across the page: Caslon italic, sentence case. */
  .role { font-family: var(--f-display); font-style: italic; font-size: var(--t-base); color: var(--c-ink-soft); }
  .band.lift .role { color: var(--c-brass); font-size: var(--t-lg); }

  /* Co-chairs are equals: identical treatment, same motion timing, and side by side on wide screens so neither reads first. */
  .chairs { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-12); }
  .chair {
    position: relative;
    display: grid;
    grid-template-columns: var(--photo-chair) minmax(0, 1fr);
    column-gap: var(--s-12);
    align-items: start;
    padding-top: var(--s-8);
  }
  .chair::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 2px;
    background: var(--c-brass);
    transform-origin: left;
    animation: rule-draw 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .chair-text { display: grid; gap: var(--s-4); align-content: start; }
  .chair-name {
    font-size: clamp(2.2rem, 1.4rem + 3vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
    color: var(--c-on-navy);
    animation: name-rise 800ms cubic-bezier(0.16, 1, 0.3, 1) 120ms both;
  }
  .chair-text .role { margin-top: calc(var(--s-2) * -1); }
  /* Two columns of about 50 characters. */
  .chair-bio {
    font-family: var(--f-prose);
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--c-on-navy-soft);
    column-width: 21rem;
    column-gap: var(--s-12);
    padding-top: var(--s-6);
    border-top: 1px solid rgb(181 158 127 / 0.35);
  }
  .chair-bio :global(a) { color: var(--c-on-navy); text-decoration-color: var(--c-brass); text-decoration-thickness: 1px; }
  .chair-bio :global(a:hover) { text-decoration-color: var(--c-on-navy); }
  .chair-bio :global(a:focus-visible) { outline-color: var(--c-brass); }
  @keyframes rule-draw { from { transform: scaleX(0); } }
  @keyframes name-rise { from { opacity: 0; transform: translateY(14px); } }

  /* Plates share one shape; the missing-photo variant is quiet, not a block. */
  .plate {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--c-navy);
    display: grid;
    grid-template: 100% / 100%;
    place-items: center;
  }
  .plate img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .plate .initial { font-family: var(--f-display); font-weight: 700; line-height: 1; color: var(--c-brass); font-size: 3rem; }
  .plate.empty-plate { background: transparent; box-shadow: inset 0 0 0 1px var(--c-rule); }
  .plate.empty-plate .initial { color: var(--c-brass); font-weight: 400; opacity: 0.8; }
  .chair .plate { width: var(--photo-chair); box-shadow: 0 0 0 1px rgb(181 158 127 / 0.4); }
  .chair .plate.empty-plate { background: rgb(255 255 255 / 0.04); box-shadow: inset 0 0 0 1px rgb(181 158 127 / 0.4); }
  .chair .plate .initial { font-size: 5rem; }
  .head .plate .initial { font-size: 3.4rem; }

  .years ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-6);
    list-style: none;
    margin: 0;
    padding: var(--s-6) 0 0;
    font-size: var(--t-sm);
  }

  .block { display: grid; gap: var(--s-8); padding-block: var(--s-16); }
  .block h2 { font-size: var(--t-2xl); color: var(--c-navy); }
  .empty { font-family: var(--f-prose); font-style: italic; color: var(--c-ink-faint); padding-block: var(--s-8); }

  .people { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-12); }
  .bio { font-family: var(--f-prose); color: var(--c-ink-soft); max-width: 46ch; }
  .bio :global(a) { color: var(--c-navy); }

  /* Heads: ruled column, mid-size portrait. */
  .heads { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-12); }
  .head {
    display: grid;
    grid-template-columns: var(--photo-head) minmax(0, 1fr);
    gap: var(--s-6);
    align-items: start;
    border-top: 2px solid var(--c-brass);
    padding-top: var(--s-4);
  }
  .head .plate { width: var(--photo-head); }
  .head-text { display: grid; gap: var(--s-2); align-content: start; }
  .head-name { font-size: var(--t-2xl); line-height: 1.1; color: var(--c-navy); }
  .head .bio { margin-top: var(--s-2); }

  /* Mentors: the smallest portraits, three across. */
  .mentors { margin-top: var(--s-8); }
  /* Last on the page, the band runs into the footer. */
  .mentors:last-child { margin-bottom: calc(var(--s-24) * -1); }
  .plates { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-12) var(--s-8); }
  .mentor { display: grid; gap: var(--s-2); align-content: start; }
  /* Printed-plate treatment: a white mat, a hairline brass keyline inside it,
     and a faint navy grade over the photo so four different backdrops sit
     together as one set. */
  .mentor .plate {
    --mat: 0.45rem;
    position: relative;
    width: var(--photo-mentor);
    margin-bottom: var(--s-3);
    padding: var(--mat);
    box-sizing: content-box;
    aspect-ratio: auto;
    background: var(--c-surface);
    box-shadow: 0 1px 2px rgb(21 34 47 / 0.14), 0 14px 24px -14px rgb(21 34 47 / 0.4);
    grid-template: none;
    place-items: stretch;
    overflow: visible;
  }
  .mentor .plate img,
  .mentor .plate .initial { aspect-ratio: 4 / 5; width: 100%; height: auto; display: block; }
  .mentor .plate.empty-plate { background: var(--c-surface); box-shadow: 0 1px 2px rgb(21 34 47 / 0.14), 0 14px 24px -14px rgb(21 34 47 / 0.4); }
  .mentor .plate .initial {
    display: grid;
    place-items: center;
    background: var(--c-sunk);
    font-size: 2.6rem;
  }
  .mentor .plate::before {
    content: '';
    position: absolute;
    inset: var(--mat);
    z-index: 1;
    pointer-events: none;
    background: var(--c-navy);
    mix-blend-mode: soft-light;
    opacity: 0.1;
  }
  .mentor .plate::after {
    content: '';
    position: absolute;
    inset: calc(var(--mat) + 5px);
    z-index: 2;
    pointer-events: none;
    border: 1px solid rgb(255 255 255 / 0.45);
  }
  .mentor .plate .initial + * { display: none; }
  .mentor-name { font-size: var(--t-xl); line-height: 1.15; color: var(--c-navy); }
  .mentor .bio { font-size: var(--t-sm); margin-top: var(--s-2); }
  .head:hover .plate img { transform: scale(1.03); }
  .mentor .plate { overflow: hidden; }
  .mentor:hover .plate img { transform: scale(1.03); }

  /* Past years: a ruled roll, name left, role right. */
  .roll { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--c-brass); }
  .roll li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-4);
    align-items: baseline;
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--c-rule);
  }
  .roll-name { font-family: var(--f-display); font-size: var(--t-lg); }
  .roll-role { font-size: var(--t-sm); color: var(--c-ink-soft); }
  .alumni-head { padding-bottom: 0; }
  .archive { padding-block: var(--s-8) 0; }
  .archive:last-child { padding-bottom: var(--s-8); }
  .archive h3 { font-size: var(--t-xl); color: var(--c-navy); }

  @media (min-width: 1000px) {
    .chairs { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s-16); align-items: start; }
    .chair { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-6); }
    .chair-bio { column-count: 1; column-width: auto; }
    .chair-name { font-size: clamp(2rem, 2.2vw + 0.6rem, 2.7rem); white-space: nowrap; }
  }

  @media (max-width: 860px) {
    .masthead { gap: var(--s-12); padding-block: var(--s-12); }
    :global(:root) { --photo-chair: 10rem; --photo-head: 8rem; }
    .chair { column-gap: var(--s-8); }
    .heads { grid-template-columns: minmax(0, 1fr); }
    .plates { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    :global(:root) { --photo-chair: 11rem; --photo-head: 7rem; }
    .chair { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-6); }
    .chair-bio { column-width: auto; column-count: 1; }
    .plates { grid-template-columns: minmax(0, 1fr); }
    .roll li { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .plate img { transition: none; }
    .mentor:hover .plate img, .head:hover .plate img { transform: none; }
  }
</style>
