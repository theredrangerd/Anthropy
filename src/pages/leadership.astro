---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const years = (await getCollection('leadership')).sort(
  (a, b) => b.data.startYear - a.data.startYear,
);
const current = years.find((y) => y.data.current) ?? years[0];
const previous = years.filter((y) => y.id !== current?.id);

const tierGroups = [
  { tier: 'lead', members: current?.data.members.filter((m) => m.tier === 'lead') ?? [] },
  { tier: 'core', members: current?.data.members.filter((m) => m.tier === 'core') ?? [] },
  { tier: 'mentor', members: current?.data.members.filter((m) => m.tier === 'mentor') ?? [] },
];
---
<BaseLayout
  title="Leadership"
  description="The students who lead Anthropy, and those who led it before them."
>
  <section class="head">
    <p class="eyebrow">The team</p>
    <h1>Leadership</h1>
  </section>

  {years.length > 1 && (
    <nav class="years" aria-label="Leadership years">
      <ul>
        {years.map((y) => (
          <li><a href={`#year-${y.data.startYear}`}>{y.data.academicYear}</a></li>
        ))}
      </ul>
    </nav>
  )}

  {years.length === 0 && (
    <p class="empty">The leadership roster is being recorded.</p>
  )}

  {current && (
    <section class="year" id={`year-${current.data.startYear}`}>
      <h2>{current.data.academicYear}</h2>
      {current.data.members.length === 0 ? (
        <p class="empty">This year's team is being confirmed.</p>
      ) : (
        <ul class="bento">
          {tierGroups.map(({ tier, members }) =>
            members.map((m, i) => {
              // Typing speed for the reveal below: ~20 chars/sec for the role
              // tag, ~55/sec for the longer bio, each with a sane floor so
              // even a short string visibly types rather than blinking in.
              const roleDur = Math.max(m.role.length / 20, 0.3).toFixed(2);
              const bioDur = Math.max((m.bio?.length ?? 0) / 55, 0.6).toFixed(2);
              return (
                <li
                  class="tile"
                  data-tier={tier}
                  tabindex="0"
                  style={`--role-dur: ${roleDur}s; --bio-dur: ${bioDur}s; --chars: ${m.role.length}`}
                  class:list={{ alt: tier === 'mentor' && i % 2 === 1 }}
                >
                  <div class="portrait">
                    {m.photo ? (
                      <img class="avatar" src={m.photo} alt={m.name} style={`object-position: ${m.photoPosition}`} />
                    ) : (
                      <span class="avatar placeholder" aria-hidden="true">{m.name.charAt(0)}</span>
                    )}
                  </div>
                  <span class="role-tag">{m.role}</span>
                  <p class="name">{m.name}</p>
                  {m.bio && <p class="bio">{m.bio}</p>}
                </li>
              );
            }),
          )}
        </ul>
      )}
    </section>
  )}

  {previous.map((y) => (
    <section class="year" id={`year-${y.data.startYear}`}>
      <h2>{y.data.academicYear}</h2>
      {y.data.members.length === 0 ? (
        <p class="empty">Roster not yet recorded.</p>
      ) : (
        <ul class="people auto-grid">
          {y.data.members.map((m) => (
            <li>
              <p class="name">{m.name}</p>
              <p class="role">{m.role}</p>
              <p class="campus">{m.campus}</p>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
</BaseLayout>

<script>
  // Progressive enhancement: the role tag and bio are real text in the DOM
  // from the start (readable without JS, by search engines, and by anything
  // that ignores hover). With JS, CSS hides them until the first hover or
  // keyboard focus, then a class permanently reveals that one tile — the
  // typewriter-style transition itself lives entirely in CSS, timed by the
  // --role-dur/--bio-dur custom properties set per tile.
  const tiles = document.querySelectorAll<HTMLElement>('.tile');
  for (const tile of tiles) {
    const reveal = () => tile.classList.add('revealed');
    tile.addEventListener('mouseenter', reveal, { once: true });
    tile.addEventListener('focusin', reveal, { once: true });
  }
</script>

<style>
  .head { display: grid; gap: var(--s-4); padding-block: var(--s-16) var(--s-8); }
  .years ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    list-style: none;
    margin: 0 0 var(--s-8);
    padding: 0;
    font-size: var(--t-sm);
  }
  .year { padding-block: var(--s-8); border-top: 1px solid var(--c-rule); display: grid; gap: var(--s-6); }

  /* Past years: plain uniform grid. */
  .people {
    --auto-grid-min: 220px;
  }
  .people li { display: grid; gap: var(--s-1); }
  .people .name { font-family: var(--f-display); font-size: var(--t-lg); }
  .people .role { font-size: var(--t-sm); color: var(--c-sage); }
  .people .campus { font-size: var(--t-xs); color: var(--c-ink-faint); }
  .empty { font-family: var(--f-prose); font-style: italic; color: var(--c-ink-faint); }

  /* Current year: bento grid. Six columns; tile size (via column span and
     padding/type scale) reflects tier, not document order. Auto-placement
     relies on tiles being rendered grouped by tier: two leads (span 3 each,
     one row), two core (span 3 each, one row), three mentors (span 2 each,
     one row). */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--s-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tile {
    position: relative;
    overflow: hidden;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--s-2);
    text-align: center;
    border: 1px solid var(--c-rule);
    border-radius: 6px;
  }

  .tile[data-tier='lead'] {
    grid-column: span 3;
    padding: var(--s-8);
    background: var(--c-sage-soft);
    min-height: 15rem;
  }
  .tile[data-tier='core'] {
    grid-column: span 3;
    padding: var(--s-6);
    background: var(--c-rust-soft);
    min-height: 10rem;
  }
  .tile[data-tier='mentor'] {
    grid-column: span 2;
    padding: var(--s-4);
    background: var(--c-surface);
    min-height: 8rem;
  }
  .tile[data-tier='mentor'].alt { background: var(--c-sunk); }

  /* The photo (or placeholder initial) is the tile's centerpiece: bigger
     and higher up the hierarchy than the name/role text below it. */
  .portrait { margin-bottom: var(--s-2); }

  .avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--c-surface);
    box-shadow: 0 4px 12px rgba(20, 36, 58, 0.2);
    font-family: var(--f-display);
    color: var(--c-ink-faint);
    background: var(--c-sunk);
  }
  .tile[data-tier='lead'] .avatar { width: 9rem; height: 9rem; font-size: var(--t-2xl); }
  .tile[data-tier='core'] .avatar { width: 7rem; height: 7rem; font-size: var(--t-xl); }
  .tile[data-tier='mentor'] .avatar { width: 5.5rem; height: 5.5rem; font-size: var(--t-lg); }

  /* Hidden until revealed: box-sizing:border-box makes max-width:0 truly
     zero-size (no residual border/padding "pill" ghost), so an unrevealed
     tile shows only the photo and name. Revealing is permanent — a class
     added once by script on first hover/focus — and the type-in itself is
     timed entirely by CSS via the --role-dur/--bio-dur/--chars custom
     properties set per tile. */
  .role-tag {
    font-family: var(--f-ui);
    font-size: var(--t-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
    border-style: solid;
    border-radius: 999px;
    background: var(--c-ground);
    box-sizing: border-box;
    overflow: hidden;
    white-space: nowrap;
    max-width: 0;
    padding: 0;
    border-width: 0;
    transition:
      max-width var(--role-dur, 0.3s) steps(var(--chars, 10)),
      padding 0.01s var(--role-dur, 0.3s),
      border-width 0.01s var(--role-dur, 0.3s);
  }
  .tile[data-tier='lead'] .role-tag { transform: rotate(-2deg); }
  .tile.revealed .role-tag {
    max-width: 24ch;
    padding: var(--s-1) var(--s-3);
    border-width: 1px;
    border-color: var(--c-rule);
    transition:
      max-width var(--role-dur, 0.3s) steps(var(--chars, 10)),
      padding 0.01s,
      border-width 0.01s;
  }

  .tile .name { font-family: var(--f-display); }
  .tile[data-tier='lead'] .name { font-size: var(--t-xl); }
  .tile[data-tier='core'] .name { font-size: var(--t-lg); }
  .tile[data-tier='mentor'] .name { font-size: var(--t-base); }

  .tile .bio {
    font-family: var(--f-prose);
    color: var(--c-ink-soft);
    max-width: 42ch;
    clip-path: inset(0 100% 0 0);
    transition: clip-path var(--bio-dur, 0.6s) linear;
  }
  .tile[data-tier='mentor'] .bio { font-size: var(--t-sm); }
  .tile.revealed .bio {
    clip-path: inset(0 0 0 0);
    transition: clip-path var(--bio-dur, 0.6s) linear var(--role-dur, 0.3s);
  }

  /* The global reduced-motion rule (global.css) zeroes durations but not
     delays, so without this the bio would still wait out --role-dur before
     snapping into view. Zero the delay too, so reduced-motion users get
     everything at once. */
  @media (prefers-reduced-motion: reduce) {
    .tile.revealed .bio { transition-delay: 0s; }
  }

  @media (max-width: 720px) {
    .bento { grid-template-columns: 1fr; }
    .tile[data-tier='lead'],
    .tile[data-tier='core'],
    .tile[data-tier='mentor'] {
      grid-column: 1 / -1;
    }
  }
</style>
